{% extends 'base.html.twig' %}

{% block title %}Hello World ! {% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
    <h1>Hello {{ controller_name }}! ✅</h1>

    {# <a href="{{ path('redirection_evenement') }}">Voir les événéments</a> #}

    {% for article in articles %}
    <h2>{{ article.titre }}</h2>
    <p>Catégorie : {{ article.categorie.nom | default('N/A')}}
    <p>{{ article.contenue }}<p>
    <p> Ecrit par {{ article.auteur.nom }} , le {{ article.date | date('d/m/Y') }}</p>
    <p> Ecrit par {{ article.auteur }}</p>  
    <a href="{{ path('article_show', {'id': article.id}) }}"> Voir l'article</a>
    <hr>
    {% endfor %}
</div>
{% endblock %}
