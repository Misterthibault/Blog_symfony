{% extends 'base.html.twig' %}

{% block title %}Hello articleshow!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">


    <h2>{{ article.titre }}</h2>
    <p>{{ article.contenue }}<p>
    <p>Catégorie : {{ article.categorie.nom | default('N/A')}}
    <p> Ecrit par {{ article.auteur.nom }} , le {{ article.date | date('d/m/Y') }}</p>
    <p> Ecrit par {{ article.auteur }}</p>  

    {# <p>{{ commentaire.texte }}</p> #}
    <br>
    <a href="{{ path('app_article') }}"> Retourner a l'ecran d'accueil<a/>
    <hr>

</div>
{% endblock %}
