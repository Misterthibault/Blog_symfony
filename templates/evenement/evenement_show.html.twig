{% extends 'base.html.twig' %}

{% block title %}Hello evenementshow!{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">


    <h2>{{ evenement.nom }}</h2>
    <p>{{ evenement.description }}<p>
    <p>Lieu: {{ evenement.lieu }}</p>
    le {{ evenement.date | date('d/m/Y') }}</p>
    <p> creer par {{ nomUser}}</p>  
    
    <a href="{{ path('app_evenement_edit', {'id' : evenement.id}) }}">Modifier</a>
    <br>
    - <a onclick="return confirm('Voulez vous supprimer cette evenement');" href="{{ path('app_evenement_delete', {'id' : evenement.id}) }}">Supprimer</a>
    <br><br>
    <a href="{{ path('app_evenement') }}"> Retourner a l'ecran d'accueil<a/>
    <hr>

</div>
{% endblock %}
