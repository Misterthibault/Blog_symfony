{% extends 'base.html.twig' %}

{% block title %}Evenementiel{% endblock %}

{% block body %}
<style>
    .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
    .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
</style>

<div class="example-wrapper">
<h1>voici la liste des événements</h1>

<a href="{{ path('evenement_add') }}">Ajouter un événement</a>

    {% for evenement in evenements %}
    <h2>{{ evenement.nom }}</h2>
    <p>{{ evenement.description }}<p>
    <a href="{{ path('evenement_show', {'id': evenement.id}) }}"> Voir l'evenement</a>
    <hr>
    {% endfor %}


</div>
{% endblock %}
